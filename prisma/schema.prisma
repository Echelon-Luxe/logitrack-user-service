generator client {
  provider = "prisma-client-js"
  // Pinned, not detected. The build stage (node:24-bookworm-slim) has no
  // openssl CLI, so Prisma cannot detect the platform and falls back to
  // debian-openssl-1.1.x - while the distroless runtime needs 3.0.x, and
  // the engine it looks for is simply absent from the image.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// What each role may do is in logitrack-infrastructure/docs/rbac.md.
enum Role {
  CUSTOMER
  DRIVER
  ADMIN
  // Runs the floor: assigns drivers, manages every shipment.
  DISPATCHER
  // Read-only across the platform, for answering customer queries.
  SUPPORT
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  // scrypt output, never the password itself.
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(CUSTOMER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]

  @@index([role, active])
}

// Refresh tokens are stored hashed and rotated on every use. A reused token
// means it leaked, so the whole family is revoked.
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  // Rotation chain: every refresh issues a new token pointing at its parent.
  familyId   String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([familyId])
}

// Who did what to whom. Append-only: rows are never updated or deleted, so the
// log stays trustworthy even when an admin account is the thing under review.
model AuditLog {
  id         String   @id @default(uuid())
  // Null for anonymous actions, e.g. a failed login for an unknown email.
  actorId    String?
  actorEmail String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
}
