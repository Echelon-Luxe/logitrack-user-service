# Copy to .env and fill in. .env is gitignored - never commit real values.

DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=users"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=users"

# RS256 key pair. Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -pubout -in private.pem -out public.pem
# Only the PUBLIC key goes to the gateway. Without these a per-process ephemeral
# pair is generated, which breaks the moment there is more than one replica.
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""

PORT=3001
LOG_LEVEL=debug

# Ship logs to Seq as well as stdout. Unset = stdout only, which is what
# Kubernetes wants: Fluent Bit tails stdout there and would duplicate every
# line. Local Seq comes up with the infrastructure repo's
# local/docker-compose.yml; UI on http://localhost:8081.
SEQ_URL="http://localhost:5341"
# SEQ_API_KEY=""
